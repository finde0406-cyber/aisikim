# AI시킴 환경변수 예시
# 실제 값은 .env.local에 설정하세요 (git 추적 안 됨)

# ─── 메일 발송 설정 ────────────────────────────────────
# MAIL_PROVIDER: resend | (미설정 = mock 모드)
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=hello@aisikim.com

# 관리자 신청·결제 알림 수신 이메일
ADMIN_NOTIFY_EMAIL=hello@aisikim.com

# ─── 샘플팩 자료 링크 ──────────────────────────────────
SAMPLE_PACK_PDF_URL=https://...
SAMPLE_PACK_NOTION_URL=https://notion.so/...

# ─── 집중팩 자료 링크 ──────────────────────────────────
DEV_PACK_PDF_URL=https://...
DEV_PACK_NOTION_URL=https://notion.so/...

WORK_PACK_PDF_URL=https://...
WORK_PACK_NOTION_URL=https://notion.so/...

BLOG_PACK_PDF_URL=https://...
BLOG_PACK_NOTION_URL=https://notion.so/...

# ─── 통합 스타터팩 번들 자료 링크 ──────────────────────
STARTER_BUNDLE_PDF_URL=https://...
STARTER_BUNDLE_NOTION_URL=https://notion.so/...
STARTER_BUNDLE_GUIDE_URL=https://notion.so/...

# ─── 결제 웹훅 보안 ────────────────────────────────────
# 결제 provider에서 보내는 웹훅 요청 검증용 시크릿
# 미설정 시 검증 건너뜀 (개발/테스트 시)
PAYMENT_WEBHOOK_SECRET=

# ─── 운영자 내부 발송 화면 보안 (/internal/send-pack) ────
# 아무 문자열이나 설정 가능 — 운영자만 알고 있어야 함
INTERNAL_ACCESS_KEY=

# ─── 기존 환경변수 (유지 중) ───────────────────────────
# 유료 결제 페이지 URL (스타터팩 번들)
NEXT_PUBLIC_PAYMENT_URL=https://store.nicepay-checkout.co.kr/products/ITM26060216544531755

# 집중팩 개별 구매 URL (추후 개별 설정)
NEXT_PUBLIC_DEV_PACK_URL=https://store.nicepay-checkout.co.kr/products/ITM26060216481354090
NEXT_PUBLIC_WORK_PACK_URL=https://store.nicepay-checkout.co.kr/products/ITM26060216502428248
NEXT_PUBLIC_BLOG_PACK_URL=https://store.nicepay-checkout.co.kr/products/ITM26060216523448692
